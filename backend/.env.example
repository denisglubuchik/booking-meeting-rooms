LOG_LEVEL="INFO"
LOG_FORMAT="console"

PG_HOST=db
PG_DB=booking_db
PG_USER=booking_user
PG_PASS=booking_password
PG_PORT=5432

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=''
REDIS_USER='default'
REDIS_DB=0
APP_REDIS_PREFIX='booking:dev'

JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES_MINUTES=15
JWT_ISSUER="booking-backend"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES_DAYS=14
REFRESH_COOKIE_PATH="/api/v1/auth"
REFRESH_COOKIE_SECURE=False
CORS_ALLOW_ORIGINS="http://localhost:5173,https://bookingdiplom.ru,https://www.bookingdiplom.ru"

S3_ENDPOINT_URL="https://s3.ru-3.storage.selcloud.ru"
# Optional public endpoint used only for browser-facing presigned URLs.
# If empty, S3_ENDPOINT_URL is used.
S3_PUBLIC_ENDPOINT_URL=""
S3_REGION="ru-3"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PRESIGN_EXPIRES_SECONDS=900
S3_USE_PATH_STYLE=false

EMAIL_ENABLED=false
EMAIL_FROM="noreply@booking.local"
SMTP_HOST="mailhog"
SMTP_PORT=1025
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false
SMTP_TIMEOUT_SECONDS=10

DISPATCH_POLL_INTERVAL_SECONDS=60
DISPATCH_MAX_ATTEMPTS=5
DISPATCH_RETRY_BASE_SECONDS=60
DISPATCH_RETRY_MAX_BACKOFF_SECONDS=3600
REMINDER_SELECTOR_INTERVAL_SECONDS=60
BOOKING_COMPLETION_INTERVAL_SECONDS=600
BOOKING_COMPLETION_SCAN_LIMIT=500
REMINDER_LEAD_MINUTES=10
REMINDER_SCAN_LIMIT=500
WORKER_TIMEZONE="Europe/Moscow"
WORKER_MISFIRE_GRACE_TIME_SECONDS=30
